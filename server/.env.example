# Server Port & Environment
PORT=5005
NODE_ENV=development

# CORS Allowlist
CORS_ORIGIN=http://localhost:5173

# Direct MongoDB URI (leave empty if using individual Atlas parameters below)
MONGODB_URI=

# MongoDB Atlas Encoded Connection Configuration
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_CLUSTER=
MONGODB_DB_NAME=AiTaksManagemt
MONGODB_AUTH_SOURCE=admin
# Note: Atlas does not require authMechanism. If specified, only use SCRAM-SHA-1 or SCRAM-SHA-256 (MONGODB-CR is obsolete/unsupported).
MONGODB_AUTH_MECHANISM=SCRAM-SHA-1

# Local Ollama AI Runtime (Qwen or Llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
